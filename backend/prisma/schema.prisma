// ═══════════════════════════════════════════════════════
//  SIMS Pro – Prisma Schema · PostgreSQL
// ═══════════════════════════════════════════════════════
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  SUPER_ADMIN
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
  GRACE
}

enum RoleScope {
  SYSTEM
  SCHOOL
}

enum FeeStatus {
  PAID
  PENDING
  PARTIAL
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum ExamType {
  UNIT_TEST
  MID_TERM
  MST1
  MST2
  FINAL
  PRACTICALS
}

enum ExamCategory {
  MST1
  MID_TERM
  MST2
  FINAL
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

model User {
  id           String    @id @default(cuid())
  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email        String    @unique
  password     String
  role         Role      @default(STUDENT)
  name         String
  phone        String?
  isActive     Boolean   @default(true)
  mustChangePwd Boolean  @default(false)
  refreshToken      String?
  lastLogin         DateTime?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  student      Student?
  teacher      Teacher?
  @@index([schoolId, role])
  @@map("users")
}

model School {
  id              String             @id @default(cuid())
  schoolCode      String             @unique
  name            String
  slug            String             @unique
  subdomain       String?            @unique
  customDomain    String?            @unique
  contactPerson   String
  email           String             @unique
  phone           String?
  address         String?
  status          SchoolStatus       @default(PENDING)
  onboardingDone  Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  users           User[]
  students        Student[]
  teachers        Teacher[]
  classes         Class[]
  fees            Fee[]
  notices         Notice[]
  homework        Homework[]
  attendance      Attendance[]
  marks           Mark[]
  timetableSlots  TimetableSlot[]
  attendanceSessions AttendanceSession[]
  exams           Exam[]
  assignments     Assignment[]
  classSubjectTeachers ClassSubjectTeacher[]
  subjectAttendanceRecords SubjectAttendance[]
  dateSheetEntries DateSheetEntry[]
  assignmentSubmissions AssignmentSubmission[]
  examInvigilators ExamInvigilator[]
  subscriptions   Subscription[]
  roles           AccessRole[]
  settings        SchoolSetting[]
  reportCardTemplates ReportCardTemplate[]
  generatedMarksheets GeneratedMarksheet[]

  @@map("schools")
}

model Plan {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  priceMonthly    Decimal  @db.Decimal(10, 2)
  priceAnnual     Decimal? @db.Decimal(10, 2)
  studentLimit    Int
  teacherLimit    Int
  storageLimitMb  Int?
  features        Json
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   Subscription[]
  @@map("plans")
}

model Subscription {
  id             String             @id @default(cuid())
  schoolId       String
  planId         String
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])
  startDate      DateTime
  expiryDate     DateTime
  status         SubscriptionStatus @default(ACTIVE)
  autoRenew      Boolean            @default(false)
  studentLimitSnap Int
  teacherLimitSnap Int
  amountPaid     Decimal?           @db.Decimal(10, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([schoolId, status])
  @@map("subscriptions")
}

model AccessRole {
  id          String   @id @default(cuid())
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code        String
  name        String
  scope       RoleScope @default(SCHOOL)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]

  @@unique([schoolId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  module      String
  createdAt   DateTime @default(now())

  roles       RolePermission[]
  @@map("permissions")
}

model RolePermission {
  id            String      @id @default(cuid())
  roleId        String
  permissionId  String
  role          AccessRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model SchoolSetting {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key         String
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, key])
  @@map("school_settings")
}

model Student {
  id           String   @id @default(cuid())
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roll         String
  className    String
  phone        String
  parentName   String
  parentPhone  String   @default("")
  address      String
  dob          DateTime
  photoUrl     String?
  admissionNo  String?
  fatherName   String?
  motherName   String?
  gender       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fees                  Fee[]
  attendance            Attendance[]
  marks                 Mark[]
  subjectAttendance     SubjectAttendance[]
  assignmentSubmissions AssignmentSubmission[]
  generatedMarksheets   GeneratedMarksheet[]
  @@unique([schoolId, roll])
  @@map("students")
}

model Teacher {
  id              String   @id @default(cuid())
  schoolId        String?
  school          School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode    String
  subject         String
  assignedClasses String
  phone           String
  qualification   String
  experience      String
  salary          Int
  photoUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  homework           Homework[]
  attendance         Attendance[]
  timetableSlots     TimetableSlot[]
  mappings           ClassSubjectTeacher[]
  attendanceSessions AttendanceSession[]
  assignments        Assignment[]
  @@map("teachers")
  invigilating ExamInvigilator[]
  @@unique([schoolId, employeeCode])
}

model Class {
  id           String   @id @default(cuid())
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  teacherName  String   @default("")
  room         String
  subject      String
  studentCount Int      @default(0)
  grade        String
  section      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([schoolId, name])
  @@map("classes")
}

model Fee {
  id        String    @id @default(cuid())
  schoolId  String?
  school    School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term      String
  tuition   Int       @default(0)
  transport Int       @default(0)
  lab       Int       @default(0)
  sports    Int       @default(0)
  amount    Int
  paid      Int       @default(0)
  status    FeeStatus @default(PENDING)
  paidDate  DateTime?
  receiptNo String?   @unique
  remarks   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([schoolId, status])
  @@map("fees")
}

model Notice {
  id          String    @id @default(cuid())
  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  body        String
  target      String    @default("All")
  priority    Priority  @default(MEDIUM)
  isPublished Boolean   @default(true)
  publishedBy String    @default("Admin")
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([schoolId, isPublished])
  @@map("notices")
}

model Homework {
  id            String   @id @default(cuid())
  schoolId      String?
  school        School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject       String
  className     String
  title         String
  description   String
  dueDate       DateTime
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([schoolId, dueDate])
  @@map("homework")
}

model Attendance {
  id        String           @id @default(cuid())
  schoolId  String?
  school    School?          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher          @relation(fields: [teacherId], references: [id])
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  remark    String?
  createdAt DateTime         @default(now())
  @@unique([schoolId, studentId, date])
  @@index([schoolId, date])
  @@map("attendance")
}

model Mark {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   String
  examType  ExamType @default(UNIT_TEST)
  marks     Int
  maxMarks  Int      @default(100)
  grade     String?
  className String
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId, studentId, subject, examType, year])
  @@index([schoolId, className, year])
  @@map("marks")
}

model ClassSubjectTeacher {
  id             String   @id @default(cuid())
  schoolId      String?
  school        School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  className      String
  subject        String
  teacherId      String
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  periodsPerWeek Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([schoolId, className, subject])
  @@index([schoolId, className])
  @@map("class_subject_teachers")
}

model TimetableSlot {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  className String
  subject   String
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  period    Int
  startTime String
  endTime   String
  room      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId, className, dayOfWeek, period])
  @@index([schoolId, className])
  @@map("timetable_slots")
}

model AttendanceSession {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  className String
  subject   String
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  period    Int
  topic     String?
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  records   SubjectAttendance[]
  @@unique([schoolId, className, subject, date, period])
  @@index([schoolId, className, date])
  @@map("attendance_sessions")
}

model SubjectAttendance {
  id        String            @id @default(cuid())
  schoolId  String?
  school    School?           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus  @default(PRESENT)
  remark    String?
  createdAt DateTime          @default(now())
  @@unique([schoolId, sessionId, studentId])
  @@index([schoolId, studentId])
  @@map("subject_attendance")
}

model Exam {
  id           String       @id @default(cuid())
  schoolId     String?
  school       School?      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  className    String
  examType     ExamCategory
  title        String
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  isPublished  Boolean      @default(false)
  instructions String?
  pdfUrl       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  dateSheets   DateSheetEntry[]
  @@unique([schoolId, className, examType])
  @@index([schoolId, className, examType])
  @@map("exams")
}

model DateSheetEntry {
  id           String   @id @default(cuid())
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject      String
  date         DateTime @db.Date
  startTime    String
  endTime      String
  room         String   @default("")
  maxMarks     Int      @default(100)
  passingMarks Int      @default(33)
  createdAt    DateTime @default(now())
  @@unique([schoolId, examId, subject])
  @@index([schoolId, date])
  @@map("date_sheet_entries")
  invigilators ExamInvigilator[]
}

model Assignment {
  id          String   @id @default(cuid())
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  className   String
  subject     String
  title       String
  description String   @default("")
  dueDate     DateTime @db.Date
  maxMarks    Int      @default(10)
  maxSubmissions Int   @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  submissions AssignmentSubmission[]
  @@index([schoolId, className, dueDate])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  schoolId     String?
  school       School?          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt  DateTime         @default(now())
  fileUrl      String?
  remarks      String?
  marks        Int?
  attemptCount Int              @default(1)
  status       AssignmentStatus @default(PENDING)
  gradedAt     DateTime?
  updatedAt    DateTime         @updatedAt
  @@unique([schoolId, assignmentId, studentId])
  @@index([schoolId, status])
  @@map("assignment_submissions")
}


enum InvigilatorRole {
  HEAD_EXAMINER
  INVIGILATOR
  FLYING_SQUAD
}

model ExamInvigilator {
  id               String          @id @default(cuid())
  schoolId         String?
  school           School?         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  dateSheetEntryId String
  dateSheetEntry   DateSheetEntry  @relation(fields: [dateSheetEntryId], references: [id], onDelete: Cascade)
  teacherId        String
  teacher          Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  role             InvigilatorRole @default(INVIGILATOR)
  createdAt        DateTime        @default(now())

  @@unique([schoolId, dateSheetEntryId, teacherId])
  @@index([schoolId, teacherId])
  @@map("exam_invigilators")
}

model ReportCardTemplate {
  id                       String   @id @default(cuid())
  schoolId                 String
  school                   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                     String
  description              String?
  isDefault                Boolean  @default(false)
  isActive                 Boolean  @default(true)
  // Branding
  logoUrl                  String?
  schoolName               String?
  schoolAddress            String?
  schoolPhone              String?
  schoolEmail              String?
  schoolWebsite            String?
  affiliationNo            String?
  academicSession          String?
  schoolMotto              String?
  // Header
  reportTitle              String   @default("REPORT CARD")
  headerBgColor            String   @default("#1a3a6b")
  headerTextColor          String   @default("#ffffff")
  fontFamily               String   @default("Arial, sans-serif")
  headerAlignment          String   @default("center")
  // Layout
  paperSize                String   @default("A4")
  orientation              String   @default("PORTRAIT")
  marginTop                Int      @default(15)
  marginBottom             Int      @default(15)
  marginLeft               Int      @default(15)
  marginRight              Int      @default(15)
  // JSON fields
  studentFields            Json?
  tableColumns             Json?
  sectionLayout            Json?
  gradingSystem            Json?
  // Display flags
  showTotal                Boolean  @default(true)
  showPercentage           Boolean  @default(true)
  showGrade                Boolean  @default(true)
  showRank                 Boolean  @default(true)
  showResult               Boolean  @default(true)
  showAttendance           Boolean  @default(false)
  showPromotion            Boolean  @default(false)
  showTeacherRemarks       Boolean  @default(true)
  showPrincipalRemarks     Boolean  @default(true)
  passingPercentage        Int      @default(40)
  // Signatures / footer
  principalSignatureUrl    String?
  classTeacherSignatureUrl String?
  schoolSealUrl            String?
  footerNote               String?
  showQrCode               Boolean  @default(false)
  showGeneratedDate        Boolean  @default(true)
  showWatermark            Boolean  @default(false)
  watermarkText            String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  generatedMarksheets      GeneratedMarksheet[]

  @@index([schoolId, isDefault])
  @@map("report_card_templates")
}

model GeneratedMarksheet {
  id            String              @id @default(cuid())
  schoolId      String
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateId    String?
  template      ReportCardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  examType      String
  academicYear  Int
  className     String?
  pdfUrl        String?
  includePhoto  Boolean             @default(true)
  includeQrCode Boolean             @default(false)
  generatedAt   DateTime            @default(now())

  @@index([schoolId, studentId])
  @@index([schoolId, examType])
  @@map("generated_marksheets")
}
