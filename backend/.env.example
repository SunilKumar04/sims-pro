# ═══════════════════════════════════════════════
#  SIMS Pro – Backend Environment Variables
# ═══════════════════════════════════════════════

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://sims_user:sims_password@localhost:5432/sims_db?schema=public"

# Production note for Supabase + Render:
# Use the Supavisor Session pooler string for DATABASE_URL because Render is IPv4-only.
# Example:
# DATABASE_URL="postgresql://postgres.<project-ref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Optional:
# If you later enable Supabase's IPv4 add-on or deploy to an IPv6-capable host,
# you can set DIRECT_URL to the direct database connection string for migrations.
# DIRECT_URL="postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Optional: Auth0 (if using Auth0 instead of JWT)
# AUTH0_DOMAIN=your-domain.auth0.com
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret
# AUTH0_AUDIENCE=https://api.sims.edu.in
